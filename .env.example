# Copy this file to .env.local. These values are intentionally browser-visible.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-public-key

# Public site origin, no trailing slash. Used for canonical URLs, Open Graph
# tags, the sitemap, and structured data. Set this to the real domain in
# production; it defaults to http://localhost:3000 in development.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Server-only secrets may be added later without NEXT_PUBLIC_. Never expose a
# service-role key to browser code or commit it to source control.
# SUPABASE_SERVICE_ROLE_KEY=
